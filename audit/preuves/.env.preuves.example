# ============================================
# Variables des scripts de preuve
# ============================================
# Copier ce fichier en audit/preuves/.env.preuves puis renseigner les deux clés
# affichées par « npx supabase start ».
#
# Les mêmes valeurs doivent être reprises dans .env.local à la racine, pour que
# l'application Next et les scripts voient exactement la même configuration.
# ============================================

# --- Supabase local ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Application Next lancée en local ---
APP_URL=http://localhost:3100

# --- Stripe : aucune clé réelle n'est nécessaire ---
# Le secret ci-dessous sert uniquement à signer localement les événements forgés.
# Il doit être identique à celui de .env.local.
STRIPE_WEBHOOK_SECRET=whsec_secret_local_pour_les_preuves

# Price IDs fictifs, identiques à ceux de .env.local
STRIPE_PRICE_STARTER_MONTHLY=price_preuve_starter_mensuel
STRIPE_PRICE_STARTER_ANNUAL=price_preuve_starter_annuel
STRIPE_PRICE_GROWTH_MONTHLY=price_preuve_growth_mensuel
STRIPE_PRICE_GROWTH_ANNUAL=price_preuve_growth_annuel
STRIPE_PRICE_PRO_MONTHLY=price_preuve_pro_mensuel
STRIPE_PRICE_PRO_ANNUAL=price_preuve_pro_annuel
